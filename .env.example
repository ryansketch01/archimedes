# Archimedes environment variables
# Copy this to .env and fill in values. Never commit .env.
#
# Variables marked [active] are read by code that ships today. The rest
# are aspirational placeholders for planned sources (see
# infrastructure/source-grades.yaml). Leave them blank until the
# corresponding MCP / collector lands.

# =============================================================================
# Claude Code / Max
# =============================================================================
# IMPORTANT: Leave ANTHROPIC_API_KEY UNSET. Setting it makes Claude Code use
# the API (pay-per-token) instead of your Max subscription.
# ANTHROPIC_API_KEY=   # DO NOT SET

# =============================================================================
# Splunk (local, already running) — [active]
# =============================================================================
# HEC (write path, port 8088, plain HTTP on Frank).
# Used by scripts/splunk_log.py.
SPLUNK_HEC_URL=http://localhost:8088
SPLUNK_HEC_TOKEN=                # Create in Splunk UI, scope to archimedes index
SPLUNK_HEC_INDEX=archimedes
SPLUNK_HEC_SOURCETYPE=archimedes:event

# REST (read path, port 8089, HTTPS with self-signed cert on Frank).
# Used by mcps/splunk-query.
SPLUNK_REST_URL=https://localhost:8089
SPLUNK_REST_USER=admin
SPLUNK_REST_PASSWORD=
SPLUNK_REST_VERIFY_SSL=false     # Local instance, self-signed cert

# Additional Splunk indexes to query for IOC hunts
SPLUNK_ADDITIONAL_INDEXES=defenseclaw_local

# =============================================================================
# Discord (existing bot) — [active]
# =============================================================================
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_INTEL_BRIEFS=
DISCORD_CHANNEL_FLASH_ALERTS=
DISCORD_CHANNEL_ACTOR_REVIEW=
DISCORD_CHANNEL_COMMANDS=

# Discord listener (scripts/discord_listener.py) — [active when listener installed]
# Operator's Discord user ID (numeric snowflake). Get yours by enabling
# Developer Mode in Discord settings, then right-click your avatar -> Copy User ID.
# Only this user can trigger commands; messages from other authors are ignored.
DISCORD_OPERATOR_USER_ID=
# Optional: override log directory; default is <repo>/logs/discord-listener/
DISCORD_LISTENER_LOG_DIR=

# =============================================================================
# Tier 1 OSINT sources
# =============================================================================
SHODAN_API_KEY=                  # [active] mcps/shodan-mcp
VT_API_KEY=                      # [active] mcps/virustotal
URLSCAN_API_KEY=
# Censys: API ID + Secret pair for v2 host/cert search (Basic auth).
# Get both from https://search.censys.io/account/api — the section may be
# visually separate from the Personal Access Token section. PATs alone do
# NOT work against /api/v2/ as of 2026-05; the v2 endpoints reject Bearer
# auth with "You must authenticate with a valid API ID and secret."
CENSYS_API_ID=
CENSYS_API_SECRET=
# Optional: PAT for v3/GraphQL features when we eventually wire those up.
CENSYS_API_TOKEN=
OTX_API_KEY=                     # AlienVault OTX
GREYNOISE_API_KEY=
ABUSEIPDB_API_KEY=
HIBP_API_KEY=
GITHUB_TOKEN=                    # scopes: public_repo, gist

# Reddit (OAuth)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=archimedes/1.0

# abuse.ch (ThreatFox, MalwareBazaar) — one key works for both
ABUSECH_API_KEY=

# =============================================================================
# Tier 2 sources (populate later)
# =============================================================================
INTELX_API_KEY=
DEHASHED_API_KEY=
YOUTUBE_API_KEY=
MASTODON_ACCESS_TOKEN=
MASTODON_INSTANCE=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# =============================================================================
# SpiderFoot (self-hosted) — mcps/spiderfoot, passive-only
# =============================================================================
# Required: base URL of the SpiderFoot daemon. Run loopback-only by default.
#   sf.py -l 127.0.0.1:5001
SPIDERFOOT_URL=http://127.0.0.1:5001

# Optional HTTP Basic auth — set both if SpiderFoot started with --passwd <u>:<p>.
# Leave unset for unauthenticated loopback (default).
SPIDERFOOT_USERNAME=
SPIDERFOOT_PASSWORD=

# Optional tuning. Defaults: 600s scan timeout, 5s poll, 30s per-request timeout.
# SPIDERFOOT_SCAN_TIMEOUT_SECONDS=600
# SPIDERFOOT_POLL_INTERVAL_SECONDS=5
# SPIDERFOOT_HTTP_TIMEOUT_SECONDS=30
# SPIDERFOOT_VERIFY_SSL=true       # set false only for self-signed local certs

# =============================================================================
# theHarvester (subprocess CLI wrapper) — mcps/theharvester
# =============================================================================
# theHarvester is invoked as a subprocess. Install via:
#   uv tool install --from git+https://github.com/laramies/theHarvester.git theHarvester
# Optional: override the resolved binary path.
# THEHARVESTER_BIN=theHarvester
# THEHARVESTER_TIMEOUT_SECONDS=600
# THEHARVESTER_DEFAULT_LIMIT=100

# =============================================================================
# Dashboard
# =============================================================================
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_SECRET_KEY=            # generate with: python -c "import secrets; print(secrets.token_hex(32))"

# =============================================================================
# Operational
# =============================================================================
ARCHIMEDES_TIMEZONE=America/New_York
ARCHIMEDES_ENV=dev               # dev | prod
ARCHIMEDES_LOG_LEVEL=INFO
