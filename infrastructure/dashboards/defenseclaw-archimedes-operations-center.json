                "backgroundColor": "#0F172A",
                "colorMode": "none",
                "majorColor": "#22C55E",
                "majorFontSize": 20,
                "titleColor": "#F1F5F9",
                "subtitleColor": "#CBD5E1",
                "unitColor": "#CBD5E1"
            },
            "title": "Last Event Received",
            "type": "splunk.singlevalue"
        },
        "viz_recent_events": {
            "dataSources": {
                "primary": "ds_recent_events"
            },
            "options": {
                "backgroundColor": "#0F172A",
                "headerBackgroundColor": "#1E293B",
                "headerColor": "#F1F5F9",
                "rowBackgroundColorOdd": "#1E293B",
                "rowBackgroundColorEven": "#0F172A",
                "rowColor": "#E2E8F0",
                "titleColor": "#F1F5F9"
            },
            "title": "Recent Events",
            "type": "splunk.table"
        },
        "viz_severity": {
            "dataSources": {
                "primary": "ds_severity"
            },
            "options": {
                "backgroundColor": "#0F172A",
                "labelDisplay": "valuesAndPercentage",
                "legendLabelColor": "#E2E8F0",
                "labelColor": "#E2E8F0",
                "titleColor": "#F1F5F9",
                "seriesColors": [
                    "#EF4444",
                    "#F97316",
                    "#EAB308",
                    "#22C55E",
                    "#3B82F6"
                ]
            },
            "title": "Severity Breakdown",
            "type": "splunk.pie"
        },
        "viz_subtitle": {
            "options": {
                "fontColor": "#CBD5E1",
                "markdown": "Pi → Splunk HEC | index: defenseclaw_local"
            },
            "type": "splunk.markdown"
        },
        "viz_title": {
            "options": {
                "fontColor": "#00C7EB",
                "markdown": "# 🛡️ DefenseClaw Operations Center"
            },
            "type": "splunk.markdown"
        },
        "viz_total_events": {
            "dataSources": {
                "primary": "ds_total_events"
            },
            "options": {
                "backgroundColor": "#0F172A",
                "colorMode": "none",
                "majorColor": "#00C7EB",
                "majorFontSize": 48,
                "titleColor": "#F1F5F9",
                "subtitleColor": "#CBD5E1",
                "unitColor": "#CBD5E1"
            },
            "title": "Total Events",
            "type": "splunk.singlevalue"
        }
    },
    "dataSources": {
        "ds_arc_discord_status": {
            "name": "Archimedes Discord Posts",
            "options": {
                "query": "index=archimedes sourcetype=archimedes:operation discord_post_status=* | eval failed=if(discord_post_status!=200, 1, 0) | stats count as posts sum(failed) as failures | eval status=case(posts=0, \"🟡 NO POSTS\", failures>0, \"🔴 \".failures.\" FAIL / \".posts.\" total\", true(), \"🟢 \".posts.\" OK\") | fields status",
                "refresh": "2m",
                "refreshType": "delay"
            },
            "type": "ds.search"
        },
        "ds_arc_flash_24h": {
            "name": "Archimedes FLASH Briefs",
            "options": {
                "query": "index=archimedes sourcetype=archimedes:operation event_type=flash_brief_published | stats count as flashes",
                "refresh": "5m",
                "refreshType": "delay"
            },
            "type": "ds.search"
        },
        "ds_arc_health": {
            "name": "Archimedes Pipeline Health",
            "options": {
                "query": "index=archimedes sourcetype=archimedes:scheduler status=completed | eval failed=if(exit_code!=0, 1, 0) | stats count as runs sum(failed) as failures | eval health=case(failures>0, \"🔴 FAIL (\".failures.\")\", runs=0, \"🟡 NO DATA\", true(), \"🟢 OK (\".runs.\" runs)\") | fields health",
                "refresh": "2m",
                "refreshType": "delay"
            },
            "type": "ds.search"
        },
        "ds_arc_last_brief": {
            "name": "Archimedes Last Brief",
            "options": {
                "query": "index=archimedes sourcetype=archimedes:scheduler status=completed phase IN (\"morning-brief\", \"afternoon-brief\") | stats max(_time) as last_brief | eval last_brief=if(isnull(last_brief), \"none in window\", strftime(last_brief, \"%Y-%m-%d %H:%M:%S\"))",
                "refresh": "2m",
                "refreshType": "delay"
            },
            "type": "ds.search"
        },
        "ds_arc_phase_breakdown": {
            "name": "Archimedes Phase Breakdown",
            "options": {
                "query": "index=archimedes sourcetype=archimedes:scheduler status=completed | stats count by phase | sort -count",
                "refresh": "5m",
                "refreshType": "delay"
            },
            "type": "ds.search"
        },
        "ds_arc_recent_findings": {
            "name": "Archimedes Recent Findings",
            "options": {
                "query": "index=archimedes sourcetype=archimedes:operation event_type=finding_promoted | table _time, finding_id, digraph, wep_ceiling, topic | sort -_time | head 20",
                "refresh": "5m",
                "refreshType": "delay"
            },
            "type": "ds.search"
        },
        "ds_arc_recent_runs": {
            "name": "Archimedes Recent Runs",
            "options": {
                "query": "index=archimedes sourcetype=archimedes:scheduler status=completed | eval result=if(exit_code=0, \"ok\", \"FAIL (\".exit_code.\")\") | table _time, phase, run_id, result, duration_sec | sort -_time | head 20",
                "refresh": "2m",
                "refreshType": "delay"
            },
            "type": "ds.search"
        },
        "ds_arc_run_timeline": {
            "name": "Archimedes Phase Run Timeline",
            "options": {
                "query": "index=archimedes sourcetype=archimedes:scheduler status=completed | timechart span=1h count by phase",
                "refresh": "5m",
                "refreshType": "delay"
            },
            "type": "ds.search"
        },
        "ds_event_types": {
            "name": "Top Event Types",
            "options": {
                "query": "index=defenseclaw_local | stats count by sourcetype | sort -count | head 10",
                "refresh": "5m",
                "refreshType": "delay"
            },
            "type": "ds.search"
        },
        "ds_event_volume": {
            "name": "Event Volume",
            "options": {
                "query": "index=defenseclaw_local | timechart span=1h count as Events",
                "refresh": "5m",
                "refreshType": "delay"
            },
            "type": "ds.search"
        },
        "ds_last_seen": {
            "name": "Last Event Time",
            "options": {
                "query": "index=defenseclaw_local | stats max(_time) as last_event | eval last_event=strftime(last_event, \"%Y-%m-%d %H:%M:%S\")",
                "refresh": "2m",
                "refreshType": "delay"
            },
            "type": "ds.search"
        },
        "ds_recent_events": {
            "name": "Recent Events",
            "options": {
                "query": "index=defenseclaw_local | table _time, sourcetype, event, severity | sort -_time | head 20",
                "refresh": "2m",
                "refreshType": "delay"
            },
            "type": "ds.search"
        },
        "ds_severity": {
            "name": "Severity Breakdown",
            "options": {
                "query": "index=defenseclaw_local | stats count by severity | sort -count",
                "refresh": "5m",
                "refreshType": "delay"
            },
            "type": "ds.search"
        },
        "ds_total_events": {
            "name": "Total Events",
            "options": {
                "query": "index=defenseclaw_local | stats count as total_events",
                "refresh": "2m",
                "refreshType": "delay"
            },
            "type": "ds.search"
        }
    },
