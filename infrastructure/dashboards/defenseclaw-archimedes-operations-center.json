{
    "title": "DefenseClaw Operations Center",
    "description": "Real-time DefenseClaw security monitoring — Pi → Splunk HEC + Archimedes pipeline telemetry",
    "inputs": {
        "input_global_trp": {
            "options": {
                "defaultValue": "-24h@h,now",
                "token": "global_time"
            },
            "title": "Time Range",
            "type": "input.timerange"
        }
    },
    "defaults": {
        "dataSources": {
            "ds.search": {
                "options": {
                    "queryParameters": {
                        "earliest": "$global_time.earliest$",
                        "latest": "$global_time.latest$"
                    }
                }
            },
            "ds.spl2": {
                "options": {
                    "queryParameters": {
                        "earliest": "$global_time.earliest$",
                        "latest": "$global_time.latest$"
                    }
                }
            }
        }
    },
    "visualizations": {
        "viz_arc_bg_header": {
            "options": {
                "fillColor": "#1E293B",
                "strokeColor": "transparent"
            },
            "type": "splunk.rectangle"
        },
        "viz_arc_discord_status": {
            "dataSources": {
                "primary": "ds_arc_discord_status"
            },
            "options": {
                "backgroundColor": "#0F172A",
                "colorMode": "none",
                "majorColor": "#E2E8F0",
                "majorFontSize": 28,
                "titleColor": "#F1F5F9",
                "subtitleColor": "#CBD5E1",
                "unitColor": "#CBD5E1"
            },
            "title": "Discord Posts",
            "type": "splunk.singlevalue"
        },
        "viz_arc_flash_24h": {
            "dataSources": {
                "primary": "ds_arc_flash_24h"
            },
            "options": {
                "backgroundColor": "#0F172A",
                "colorMode": "none",
                "majorColor": "#F97316",
                "majorFontSize": 48,
                "titleColor": "#F1F5F9",
                "subtitleColor": "#CBD5E1",
                "unitColor": "#CBD5E1"
            },
            "title": "FLASH Briefs",
            "type": "splunk.singlevalue"
        },
        "viz_arc_health": {
            "dataSources": {
                "primary": "ds_arc_health"
            },
            "options": {
                "backgroundColor": "#0F172A",
                "colorMode": "none",
                "majorColor": "#E2E8F0",
                "majorFontSize": 32,
                "titleColor": "#F1F5F9",
                "subtitleColor": "#CBD5E1",
                "unitColor": "#CBD5E1"
            },
            "title": "Pipeline Health",
            "type": "splunk.singlevalue"
        },
        "viz_arc_last_brief": {
            "dataSources": {
                "primary": "ds_arc_last_brief"
            },
            "options": {
                "backgroundColor": "#0F172A",
                "colorMode": "none",
                "majorColor": "#22D3EE",
                "majorFontSize": 20,
                "titleColor": "#F1F5F9",
                "subtitleColor": "#CBD5E1",
                "unitColor": "#CBD5E1"
            },
            "title": "Last Brief Completed",
            "type": "splunk.singlevalue"
        },
        "viz_arc_phase_breakdown": {
            "dataSources": {
                "primary": "ds_arc_phase_breakdown"
            },
            "options": {
                "backgroundColor": "#0F172A",
                "labelDisplay": "valuesAndPercentage",
                "legendLabelColor": "#E2E8F0",
                "labelColor": "#E2E8F0",
                "titleColor": "#F1F5F9",
                "seriesColors": [
                    "#22D3EE",
                    "#FBBF24",
                    "#22C55E",
                    "#F97316",
                    "#A855F7",
                    "#EC4899",
                    "#3B82F6",
                    "#EF4444"
