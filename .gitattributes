# Default: auto-detect text files, normalize to LF in the repo and
# on checkout. Stops Windows CRLF warnings on every `git add` and
# prevents the line-ending drift that broke splunk-log.sh in Session 3.
* text=auto eol=lf

# Windows-native scripts must keep CRLF on disk or cmd/PowerShell
# refuses to execute them.
*.bat text eol=crlf
*.ps1 text eol=crlf
