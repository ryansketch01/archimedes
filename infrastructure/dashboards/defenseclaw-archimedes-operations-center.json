                "primary": "ds_event_types"
            },
            "options": {
                "backgroundColor": "#0F172A",
                "legendDisplay": "off",
                "orientation": "horizontal",
                "axisLabelColorX": "#CBD5E1",
                "axisLabelColorY": "#CBD5E1",
                "axisTitleColorX": "#E2E8F0",
