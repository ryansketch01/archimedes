            },
            "options": {
                "backgroundColor": "#0F172A",
                "headerBackgroundColor": "#1E293B",
                "headerColor": "#F1F5F9",
                "rowBackgroundColorOdd": "#1E293B",
                "rowBackgroundColorEven": "#0F172A",
                "rowColor": "#E2E8F0",
                "titleColor": "#F1F5F9"
