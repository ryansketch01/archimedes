                "axisLabelColorX": "#CBD5E1",
                "axisLabelColorY": "#CBD5E1",
                "axisTitleColorX": "#E2E8F0",
                "axisTitleColorY": "#E2E8F0",
                "titleColor": "#F1F5F9",
                "seriesColors": [
                    "#00C7EB"
                ]
            },
            "title": "Event Volume (Hourly)",
            "type": "splunk.bar"
        },
        "viz_last_seen": {
            "dataSources": {
                "primary": "ds_last_seen"
            },
